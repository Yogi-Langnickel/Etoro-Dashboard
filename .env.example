# Never commit real values. Prefer the JSON credential file documented in README.

# Optional override for the local credential file.
ETORO_CREDENTIALS_FILE=

# Optional official eToro API credentials. Keep server-side only.
ETORO_API_KEY=
ETORO_USER_KEY=

# Official eToro REST base URL, verified 2026-05-10.
ETORO_API_BASE_URL=https://public-api.etoro.com

# Safety flags. Keep trading disabled by default.
ENABLE_TRADING_ACTIONS=false
ENABLE_LIVE_ORDERS=false
