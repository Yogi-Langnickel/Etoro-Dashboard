# Never commit real values. Copy to .env.local for local development.

# Official eToro API credentials. Keep server-side only.
ETORO_API_KEY=
ETORO_USER_KEY=

# Base URL should be confirmed from official eToro docs before implementation.
ETORO_API_BASE_URL=https://public-api.etoro.com

# Safety flags. Keep trading disabled by default.
ENABLE_TRADING_ACTIONS=false
ENABLE_LIVE_ORDERS=false

