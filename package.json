{
  "name": "etoro-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Security-first dashboard for viewing and interacting with eToro API data.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run contract:check && npm test",
    "contract:check": "node scripts/check-money-maker-contract.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "safety:public": "node scripts/check-public-safety.mjs",
    "start": "node src/server.mjs",
    "start:offline": "node scripts/start-offline.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "node scripts/check-syntax.mjs"
  },
  "keywords": [
    "etoro",
    "dashboard",
    "finance"
  ],
  "license": "UNLICENSED"
}
